# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Chat Completions deployment used after Qdrant retrieval. A realtime-only
# deployment cannot be called through chat.completions.
AZURE_CHAT_ENDPOINT=https://your-chat-resource.cognitiveservices.azure.com
AZURE_CHAT_API_KEY=your-chat-resource-api-key
AZURE_CHAT_DEPLOYMENT=your-chat-completions-deployment-name
AZURE_CHAT_API_VERSION=2024-12-01-preview

# Azure deployment serving an embedding model such as text-embedding-3-small.
# This is the deployment name, which may differ from the underlying model name.
AZURE_EMBED_DEPLOYMENT=your-embedding-deployment-name
AZURE_EMBED_ENDPOINT=https://your-embedding-resource.cognitiveservices.azure.com
AZURE_EMBED_API_KEY=your-embedding-resource-api-key
AZURE_EMBED_API_VERSION=2024-12-01-preview

# Optional app settings
LOG_LEVEL=INFO

# Qdrant. QDRANT_API_KEY can stay blank for the local Docker database.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION=nssf

# Browser origins allowed to call FastAPI, separated by commas.
CORS_ORIGINS=http://localhost:5173

# Frontend build setting. Set this to the deployed backend URL on Render.
VITE_API_BASE_URL=http://127.0.0.1:8001

# Optional persistent history database. Supabase: Project Settings > Database
# > Connection string > Transaction pooler. Replace [YOUR-PASSWORD].
DATABASE_URL=

# Optional Langfuse monitoring. Create a project at https://cloud.langfuse.com,
# then copy its public and secret keys from Project Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=production

# LiveKit Cloud project credentials. Keep LIVEKIT_API_SECRET on the server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
