# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Chat Completions deployment used after Qdrant retrieval. A realtime-only
# deployment cannot be called through chat.completions.
AZURE_CHAT_ENDPOINT=https://your-chat-resource.cognitiveservices.azure.com
AZURE_CHAT_API_KEY=your-chat-resource-api-key
AZURE_CHAT_DEPLOYMENT=your-chat-completions-deployment-name
AZURE_CHAT_API_VERSION=2024-12-01-preview

# Azure deployment serving an embedding model such as text-embedding-3-small.
# This is the deployment name, which may differ from the underlying model name.
AZURE_EMBED_DEPLOYMENT=your-embedding-deployment-name
AZURE_EMBED_ENDPOINT=https://your-embedding-resource.cognitiveservices.azure.com
AZURE_EMBED_API_KEY=your-embedding-resource-api-key
AZURE_EMBED_API_VERSION=2024-12-01-preview

# Optional app settings
LOG_LEVEL=INFO
